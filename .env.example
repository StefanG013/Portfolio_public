# Alpaca Paper Trading API credentials
# Sign up at https://alpaca.markets/ and use the paper trading environment
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Database configuration
DB_PATH=trading_agent.db

# Symbols the agent will watch (comma-separated)
WATCH_SYMBOLS=AAPL,MSFT,GOOGL,AMZN,NVDA

# FastAPI server settings
API_HOST=0.0.0.0
API_PORT=8000

# Agent guardrails
MAX_POSITION_PCT=0.10   # Max 10% of portfolio per position
MAX_DAILY_TRADES=3      # Max trades per day
